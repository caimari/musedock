# =========================================
# MUSEDOCK CMS - GitIgnore
# =========================================

# Variables de entorno (CRÍTICO - NUNCA subir al repositorio)
.env
.env.local
.env.production
.env.backup
# Copias de seguridad del .env (.env.bak-FECHA, .env.bak.FECHA, .env.bak-mail-FECHA…): llevan claves
.env.bak*

# Archivos generados en el servidor (no son código)
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess
storage/packages/
storage/edge-guard.lock
storage/indexnow.json
__pycache__/
*.pyc
/p404.html


# Excepciones: mantener estos archivos de seguridad en control de versiones
!docs/security_updates.sql
!docs/security_updates_pgsql.sql


# Configuraciones locales
config/config.local.php

# Logs
storage/logs/*.log
storage/logs/*.txt
*.log

# Caché
storage/cache/*
!storage/cache/.gitkeep
storage/views/*
!storage/views/.gitkeep
storage/html-cache/
storage/css-auditor/

# Uploads de usuarios
public/assets/uploads/*
!public/assets/uploads/.gitkeep
assets/uploads/*
!assets/uploads/.gitkeep

# Vendor (dependencias de Composer - solo la raíz)
/vendor/

# Excepción: assets de vendor frontend SÍ deben incluirse
!public/assets/vendor/

# Node modules (si usas npm)
node_modules/
package-lock.json
yarn.lock

# IDEs y editores
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Backups
*.bak
*.backup
*.old
*.orig

# Archivos temporales
tmp/
temp/
*.tmp

# Archivos de sistema
.htaccess.backup
.htpasswd

# SQL dumps
*.sql
*.sql.gz
*.sqlite
*.db

# Composer
composer.lock
composer.phar

# Certificados y claves
*.pem
*.key
*.crt
*.cer

# Archivos de desarrollo
.phpunit.result.cache
phpunit.xml
.phpcs.xml

# Archivos específicos de musedock
storage/sessions/*
!storage/sessions/.gitkeep
storage/avatars/*
!storage/avatars/.gitkeep

# Installation lock file (generated after installation)
install.lock
core/install.lock

# Uploads and media (user content)
public/uploads/*
!public/uploads/.gitkeep
storage/app/*
!storage/app/.gitkeep

# Material de cada tenant: es privado del cliente y no va a GitHub. El repo es solo el CMS general,
# para que quien lo instale en su servidor parta de un MuseDock limpio.
/themes/tenant_*
/public/assets/themes/tenant_*
/public/assets/demos/
/public/media/file/*/tenant-*
/storage/tenants/
/storage/backups/

# Development and documentation (not for production)
docs/
.claude/

# Exceptions: Keep these files
!.env.example
!install/.htaccess
!storage/.htaccess
!config/.htaccess
!core/.htaccess
!database/.htaccess
!vendor/.htaccess

# Variantes de imagen generadas al vuelo (ImageVariant)
public/assets/cache/

# IndexNow: fichero de clave generado por instalación (Search Console)
/public/????????????????????????????????.txt

# Datos y medios del servidor (no son código): ni de tenants ni del CMS principal
/storage/storage/
/public/storage/
/storage/caddy-cache-update.txt
/modules/*.zip
